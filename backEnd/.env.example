# IPQualityScore API Configuration
# Copy this file to .env and add your actual API key

# Get your free API key at: https://www.ipqualityscore.com/create-account
IPQS_API_KEY=your_ipqualityscore_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# ==============================================
# HOW TO GET YOUR API KEY:
# ==============================================
# 1. Go to https://www.ipqualityscore.com/create-account
# 2. Sign up for a FREE account (no credit card required)
# 3. Verify your email address
# 4. Go to your dashboard
# 5. Find your API key 
# 6. Copy the key and replace "your_ipqualityscore_api_key_here" above
# 
# FREE TIER INCLUDES:
# - 1,000 lookups per month
# - 35 lookups per day
# - IP Address Reputation
# - Email Validation
# - URL Scanner
# - Phone Validation
# ==============================================